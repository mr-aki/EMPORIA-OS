# Copy to .env and replace every development value before deployment.
EMPORIA_ENVIRONMENT=development
# Only used for local legacy bearer-token compatibility. Disabled outside development.
EMPORIA_API_TOKEN=replace-with-a-long-random-secret
# Required for JWT login outside development. Generate at least 32 random characters.
EMPORIA_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Keep false by default. Enable only for controlled first-time account provisioning.
EMPORIA_ALLOW_REGISTRATION=false
EMPORIA_WORKSPACE_ID=local-workspace
# Docker Compose uses PostgreSQL; keep this password consistent with POSTGRES_PASSWORD.
EMPORIA_DATABASE_URL=postgresql+psycopg://emporia:local-dev-postgres-password@postgres:5432/emporia

POSTGRES_DB=emporia
POSTGRES_USER=emporia
POSTGRES_PASSWORD=local-dev-postgres-password

# Server-side output limits (per run, not monthly spend limits).
EMPORIA_AGENT_MAX_OUTPUT_TOKENS=2048
EMPORIA_SKILL_MAX_OUTPUT_TOKENS=2048

# Workspace-wide fixed UTC-minute execution limits (agent/skill runs only).
EMPORIA_AGENT_RUNS_PER_MINUTE=10
EMPORIA_SKILL_RUNS_PER_MINUTE=20

# Maximum simultaneous agent/skill executions per workspace; stale leases expire.
EMPORIA_AGENT_MAX_CONCURRENT_RUNS=3
EMPORIA_SKILL_MAX_CONCURRENT_RUNS=5
EMPORIA_EXECUTION_LEASE_SECONDS=300

# Optional AI API credentials. Configure only providers you intend to call.
# These are server-side API credentials, not consumer chat subscriptions.
EMPORIA_OPENAI_API_KEY=
EMPORIA_ANTHROPIC_API_KEY=
EMPORIA_GEMINI_API_KEY=

# Optional OpenAI-compatible endpoint (for example, an operator-managed Ollama server).
# In Docker, use a reachable host/service address rather than localhost on the host machine.
EMPORIA_OPENAI_COMPATIBLE_BASE_URL=
EMPORIA_OPENAI_COMPATIBLE_API_KEY=

# Optional network research via Brave Search LLM Context API (server-side key only).
EMPORIA_BRAVE_SEARCH_API_KEY=

# Durable worker queue: poll interval, execution lease and bounded retry delays.
EMPORIA_WORKER_POLL_SECONDS=2
EMPORIA_WORKER_LEASE_SECONDS=300
EMPORIA_WORKER_BACKOFF_BASE_SECONDS=5
EMPORIA_WORKER_BACKOFF_MAX_SECONDS=300

# Durable job enqueue requests per workspace per UTC minute.
EMPORIA_JOB_SUBMISSIONS_PER_MINUTE=20


# Shared database-backed login failure limits (HMAC-pseudonymized email/IP identifiers).
EMPORIA_LOGIN_ATTEMPTS_PER_EMAIL_WINDOW=5
EMPORIA_LOGIN_ATTEMPTS_PER_IP_WINDOW=30
EMPORIA_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
